# Keycloak setup
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
KEYCLOAK_TEST_USER_EMAIL=testuser@example.com
KEYCLOAK_TEST_USER_PASSWORD=1234
KEYCLOAK_CLIENT_SECRET=cosmic-fastapi-keycloak-secret-dev

# Auth BFF (shared) — used by fastapi_keycloak on :8081
AUTH_PUBLIC_URL=http://localhost:8081
FRONTEND_URL=http://localhost:5173
ENABLED_PROVIDERS=keycloak,google
SESSION_SECRET=eZxespoQKt3NciNjMFrxqp0QQ48bcv2xPUks2OwtxiZ1Ng9D4KjgOB3xIZdoEiQS
SESSION_COOKIE_NAME=cosmic_session

# Google IdP
# Authorized redirect URI in Google Console MUST be exactly:
#   http://localhost:8081/api/v1/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

